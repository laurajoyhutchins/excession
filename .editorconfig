root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{rs,go}]
indent_style = tab
indent_size = 4

[*.{json,md,yml,yaml,toml,cjs,js,ts}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
