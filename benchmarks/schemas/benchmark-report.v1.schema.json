{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/laurajoyhutchins/excession/main/benchmarks/schemas/benchmark-report.v1.schema.json",
  "title": "Excession benchmark report v1",
  "description": "A source-bound, auditable envelope for measurements. The report is not itself a correctness proof. Raw tool output and measurements remain separately retained.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "suite",
    "status",
    "subject",
    "oracle",
    "source_revisions",
    "measurements",
    "checks",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "excession.benchmark-report.v1"
    },
    "run_id": {
      "$ref": "#/$defs/sha256"
    },
    "suite": {
      "$ref": "#/$defs/slug"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "partial"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "binary_sha256"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/slug"
        },
        "binary_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "git_commit": {
          "$ref": "#/$defs/oid"
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "independent",
        "description"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source-written",
            "reviewed-qrels",
            "git-source-objects",
            "shared-index",
            "none"
          ]
        },
        "independent": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 10
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "shared-index",
                  "none"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "independent": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "source_revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        ]
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/measurement"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "oid": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "commit",
        "tree"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "$ref": "#/$defs/oid"
        },
        "tree": {
          "$ref": "#/$defs/oid"
        },
        "bundle_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unit",
        "statistic",
        "arm",
        "sample_count",
        "status"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/slug"
        },
        "unit": {
          "enum": [
            "ns",
            "us",
            "ms",
            "s",
            "bytes",
            "count",
            "ratio",
            "percent",
            "MiB"
          ]
        },
        "statistic": {
          "enum": [
            "observed",
            "count",
            "sum",
            "min",
            "max",
            "median",
            "mean",
            "p95",
            "p99"
          ]
        },
        "arm": {
          "$ref": "#/$defs/slug"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "measured",
            "not_measured",
            "unsupported",
            "failed"
          ]
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "measured"
            },
            "sample_count": {
              "minimum": 1
            }
          },
          "required": [
            "value"
          ],
          "not": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "properties": {
            "status": {
              "enum": [
                "not_measured",
                "unsupported",
                "failed"
              ]
            }
          },
          "required": [
            "reason"
          ],
          "not": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "description"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/slug"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unsupported"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "media_type",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.\\-/]+$"
        },
        "role": {
          "enum": [
            "raw-samples",
            "summary",
            "source-bundle",
            "tool-output",
            "evidence",
            "test-results"
          ]
        },
        "media_type": {
          "type": "string",
          "minLength": 3
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
