{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excession.dev/schemas/historical-review-study.v1.schema.json",
  "title": "Private historical coding-agent review study",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "repetitions",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "excession.historical-review-study.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "repo_path",
          "base",
          "candidate",
          "truth",
          "task",
          "roots",
          "oracles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "repo_path": {
            "type": "string"
          },
          "base": {
            "$ref": "#/$defs/oid"
          },
          "candidate": {
            "$ref": "#/$defs/oid"
          },
          "repair": {
            "anyOf": [
              {
                "$ref": "#/$defs/oid"
              },
              {
                "type": "null"
              }
            ]
          },
          "truth": {
            "enum": [
              "REGRESSION",
              "CLEAN"
            ]
          },
          "task": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "roots": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "oracles": {
            "type": "object",
            "required": [
              "base",
              "candidate"
            ],
            "properties": {
              "base": {
                "$ref": "#/$defs/receipt"
              },
              "candidate": {
                "$ref": "#/$defs/receipt"
              },
              "repair": {
                "$ref": "#/$defs/receipt"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "receipt": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
