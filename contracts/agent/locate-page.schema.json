{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laurajoyhutchins/excession/blob/main/contracts/agent/locate-page.schema.json",
  "title": "Excession snapshot-bound lexical candidate page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "source_commit", "source_tree", "task", "retrieval",
    "candidates", "candidate_count", "page", "index", "coverage",
    "safe_to_skip_unlisted_tests", "report_id", "cache"
  ],
  "properties": {
    "schema": {"const": "excession.agent-locate-page.v1"},
    "source_commit": {"$ref": "#/$defs/sha1"},
    "source_tree": {"$ref": "#/$defs/sha1"},
    "task": {"type": "string", "minLength": 1, "maxLength": 4096},
    "retrieval": {"const": "GIT_BLOB_FTS5_BM25"},
    "report_id": {"$ref": "#/$defs/sha256"},
    "candidates": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rank", "source", "excerpt", "ranking", "semantic_correctness"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "source": {
            "type": "object", "additionalProperties": false,
            "required": ["source_commit", "source_tree", "path", "blob", "mode"],
            "properties": {
              "source_commit": {"$ref": "#/$defs/sha1"},
              "source_tree": {"$ref": "#/$defs/sha1"},
              "path": {"type": "string", "minLength": 1},
              "blob": {"$ref": "#/$defs/sha1"},
              "mode": {"enum": ["100644", "100755"]}
            }
          },
          "excerpt": {
            "type": "object", "additionalProperties": false,
            "required": ["start_line", "end_line", "text", "method"],
            "properties": {
              "start_line": {"type": "integer", "minimum": 1},
              "end_line": {"type": "integer", "minimum": 1},
              "text": {"type": "string", "maxLength": 1600},
              "method": {"const": "TEXT_LINE_HEURISTIC"}
            }
          },
          "ranking": {"const": "FTS5_BM25_TEXT_CANDIDATE"},
          "semantic_correctness": {"const": "UNVERIFIED"}
        }
      }
    },
    "candidate_count": {"type": "integer", "minimum": 0, "maximum": 64},
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "offset", "page_size", "has_more", "next_cursor"],
      "properties": {
        "snapshot_id": {"$ref": "#/$defs/sha256"},
        "offset": {"type": "integer", "minimum": 0},
        "page_size": {"type": "integer", "minimum": 1, "maximum": 64},
        "has_more": {"type": "boolean"},
        "next_cursor": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^v1\\.[0-9a-f]{64}\\.[1-9][0-9]*$"}
          ]
        }
      }
    },
    "index": {
      "type": "object", "additionalProperties": false,
      "required": [
        "total_source_files", "indexed_source_count", "skipped_source_count",
        "pending_segments", "complete", "limits"
      ],
      "properties": {
        "total_source_files": {"type": "integer", "minimum": 0},
        "indexed_source_count": {"type": "integer", "minimum": 0},
        "skipped_source_count": {"type": "integer", "minimum": 0},
        "pending_segments": {"type": "integer", "minimum": 0},
        "complete": {"type": "boolean"},
        "limits": {
          "type": "object", "additionalProperties": false,
          "required": ["max_file_bytes", "max_bytes_per_segment", "max_files_per_segment"],
          "properties": {
            "max_file_bytes": {"type": "integer", "minimum": 256},
            "max_bytes_per_segment": {"type": "integer", "minimum": 256},
            "max_files_per_segment": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "truncated", "gaps"],
      "properties": {
        "status": {"const": "PARTIAL"},
        "truncated": {"type": "boolean"},
        "gaps": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["reason"],
            "properties": {"reason": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "safe_to_skip_unlisted_tests": {"const": false},
    "cache": {
      "type": "object", "additionalProperties": false,
      "required": ["reused_blobs", "read_blobs", "refreshed_segments", "refresh_budget_segments"],
      "properties": {
        "reused_blobs": {"type": "integer", "minimum": 0},
        "read_blobs": {"type": "integer", "minimum": 0},
        "refreshed_segments": {"type": "integer", "minimum": 0},
        "refresh_budget_segments": {"type": "integer", "minimum": 1, "maximum": 256}
      }
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
