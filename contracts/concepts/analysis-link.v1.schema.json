{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/laurajoyhutchins/excession/main/contracts/concepts/analysis-link.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "title": "Excession concept to existing analysis report link v1 (proposed)",
  "required": [
    "schema",
    "link_report_id",
    "source_commit",
    "snapshot_id",
    "analysis_report_id",
    "analysis_kind",
    "links",
    "coverage_status"
  ],
  "properties": {
    "schema": {
      "const": "excession.concepts-analysis-link.v1"
    },
    "link_report_id": {
      "$ref": "#/$defs/sha256"
    },
    "source_commit": {
      "$ref": "#/$defs/oid"
    },
    "snapshot_id": {
      "$ref": "#/$defs/sha256"
    },
    "analysis_report_id": {
      "$ref": "#/$defs/sha256"
    },
    "analysis_kind": {
      "enum": [
        "REFACTOR_CANDIDATES",
        "SCIP_REFACTOR",
        "CHANGE_IMPACT",
        "SECURITY_CANDIDATES",
        "REPOSITORY_VIEW"
      ]
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "analysis_candidate_id",
          "concept_claim_ids",
          "role",
          "assessment"
        ],
        "properties": {
          "analysis_candidate_id": {
            "$ref": "#/$defs/sha256"
          },
          "concept_claim_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/sha256"
            }
          },
          "role": {
            "enum": [
              "CONCEPT_ANNOTATION",
              "INVESTIGATION_HYPOTHESIS"
            ]
          },
          "assessment": {
            "const": "ANNOTATION_ONLY"
          }
        }
      }
    },
    "coverage_status": {
      "enum": [
        "PARTIAL",
        "DECLARED_SCOPE_COMPLETE",
        "UNKNOWN"
      ]
    }
  },
  "$defs": {
    "oid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
