{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/laurajoyhutchins/excession/main/contracts/concepts/compilation.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "title": "Excession deterministic concepts compilation receipt v1 (proposed)",
  "required": [
    "schema",
    "compilation_id",
    "source_commit",
    "source_tree",
    "input_batch_ids",
    "rule_set_id",
    "compiler_version",
    "model_id",
    "snapshot_id",
    "decisions",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "excession.concepts-compilation.v1"
    },
    "compilation_id": {
      "$ref": "#/$defs/sha256"
    },
    "source_commit": {
      "$ref": "#/$defs/oid"
    },
    "source_tree": {
      "$ref": "#/$defs/oid"
    },
    "input_batch_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "rule_set_id": {
      "$ref": "#/$defs/sha256"
    },
    "compiler_version": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "$ref": "#/$defs/sha256"
    },
    "snapshot_id": {
      "$ref": "#/$defs/sha256"
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposed",
        "unresolved",
        "rejected"
      ],
      "properties": {
        "proposed": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "reason"
        ],
        "properties": {
          "status": {
            "enum": [
              "UNSUPPORTED",
              "UNRESOLVED",
              "RESOURCE_LIMIT"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "oid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
