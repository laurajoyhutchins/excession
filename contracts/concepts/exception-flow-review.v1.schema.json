{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prospective candidate exception-path difference, not behavioral proof",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "excession.concepts.exception-flow-review.v1"
    },
    "report_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "frozen_report_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_observation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_scanned_files": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "frozen_obligations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "modified_obligations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "lost_modeled_throw_guarantees": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "simple_local_throw_removals": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "model_only_handler_warnings": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^src/main/java/.+\\.java$"
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "caught": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "catch_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2048
          },
          "base_line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000000
          },
          "base_blob": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "candidate_blob": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "candidate_line": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 2000000
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "enum": [
              "PRESERVED_MODELED_THROW_GUARANTEE",
              "LOST_MODELED_THROW_GUARANTEE",
              "HANDLER_REMOVED_OR_REKEYED_UNSUPPORTED"
            ]
          },
          "simple_local_throw_removal": {
            "type": "boolean"
          },
          "behavioral_test_generated": {
            "const": false
          },
          "validity": {
            "const": "UNVERIFIED_STATIC_HYPOTHESIS"
          }
        },
        "required": [
          "source",
          "method",
          "caught",
          "catch_index",
          "base_line",
          "base_blob",
          "candidate_blob",
          "candidate_line",
          "state",
          "simple_local_throw_removal",
          "behavioral_test_generated",
          "validity"
        ]
      }
    },
    "status": {
      "const": "UNVERIFIED_SOURCE_ONLY_CONTROL_FLOW_CHANGE"
    },
    "behavioral_oracle_seen": {
      "const": false
    },
    "repair_commit_seen": {
      "const": false
    },
    "semantic_invariant_proven": {
      "const": false
    },
    "superior_bug_prevention_proven": {
      "const": false
    }
  },
  "required": [
    "schema",
    "report_id",
    "frozen_report_id",
    "source_commit",
    "source_tree",
    "candidate_commit",
    "candidate_tree",
    "candidate_observation_sha256",
    "candidate_scanned_files",
    "frozen_obligations",
    "modified_obligations",
    "lost_modeled_throw_guarantees",
    "simple_local_throw_removals",
    "model_only_handler_warnings",
    "hypotheses",
    "status",
    "behavioral_oracle_seen",
    "repair_commit_seen",
    "semantic_invariant_proven",
    "superior_bug_prevention_proven"
  ]
}
