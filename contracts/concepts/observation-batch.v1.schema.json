{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/laurajoyhutchins/excession/main/contracts/concepts/observation-batch.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "title": "Excession normalized semantic observation batch v1 (proposed)",
  "required": [
    "schema",
    "batch_id",
    "source_commit",
    "source_tree",
    "inputs",
    "observations",
    "gaps",
    "subjects",
    "completeness"
  ],
  "properties": {
    "schema": {
      "const": "excession.concepts-observation-batch.v1"
    },
    "batch_id": {
      "$ref": "#/$defs/sha256"
    },
    "source_commit": {
      "$ref": "#/$defs/oid"
    },
    "source_tree": {
      "$ref": "#/$defs/oid"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt_id",
          "producer",
          "version",
          "kind",
          "scope"
        ],
        "properties": {
          "receipt_id": {
            "$ref": "#/$defs/sha256"
          },
          "producer": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "SCIP",
              "STATIC_SYNTAX",
              "COMPILER_DECLARATION",
              "RUNTIME_WITNESS",
              "SECURITY_SCANNER"
            ]
          },
          "configuration_id": {
            "$ref": "#/$defs/sha256"
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "maxItems": 100
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id",
          "receipt_id",
          "kind",
          "source_subject_id",
          "status",
          "source_observation_id",
          "native_relation",
          "specifier",
          "condition_evaluation",
          "rule",
          "language"
        ],
        "properties": {
          "observation_id": {
            "$ref": "#/$defs/sha256"
          },
          "receipt_id": {
            "$ref": "#/$defs/sha256"
          },
          "kind": {
            "enum": [
              "SCIP_REFERENCE",
              "SCIP_DEFINITION",
              "STATIC_IMPORT_CANDIDATE",
              "COMPILER_INPUT",
              "RUNTIME_WITNESS",
              "SCANNER_CANDIDATE"
            ]
          },
          "source_subject_id": {
            "$ref": "#/$defs/sha256"
          },
          "target_subject_id": {
            "$ref": "#/$defs/sha256"
          },
          "status": {
            "enum": [
              "OBSERVED",
              "CANDIDATE",
              "UNRESOLVED"
            ]
          },
          "source_observation_id": {
            "$ref": "#/$defs/sha256"
          },
          "native_relation": {
            "enum": [
              "IMPORTS",
              "SCIP_SYMBOL_REFERENCE"
            ]
          },
          "specifier": {
            "type": "string",
            "maxLength": 4096
          },
          "condition_evaluation": {
            "const": "NOT_EVALUATED"
          },
          "rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "STATIC_IMPORT_CANDIDATE"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "native_relation": {
                  "const": "IMPORTS"
                },
                "status": {
                  "enum": [
                    "CANDIDATE",
                    "UNRESOLVED"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "SCIP_REFERENCE"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "target_subject_id"
              ],
              "properties": {
                "native_relation": {
                  "const": "SCIP_SYMBOL_REFERENCE"
                },
                "status": {
                  "const": "OBSERVED"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "CANDIDATE"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "target_subject_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "UNRESOLVED"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "target_subject_id"
                ]
              }
            }
          }
        ]
      },
      "maxItems": 20000
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason"
        ],
        "properties": {
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "enum": [
              "UNRESOLVED_SYMBOL",
              "MISSING_PRODUCER",
              "PARTIAL_CONFIGURATION",
              "RESOURCE_LIMIT",
              "UNSUPPORTED_SOURCE"
            ]
          },
          "native_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "subjects": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/subject"
      }
    },
    "completeness": {
      "const": "PARTIAL_CANDIDATES_ONLY"
    }
  },
  "$defs": {
    "oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_line",
        "end_line",
        "encoding"
      ],
      "properties": {
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "encoding": {
          "enum": [
            "UTF8",
            "UTF16",
            "UTF32",
            "LINE_ONLY"
          ]
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "kind",
        "source_commit",
        "path",
        "blob",
        "producer",
        "producer_receipt_id"
      ],
      "properties": {
        "subject_id": {
          "$ref": "#/$defs/sha256"
        },
        "kind": {
          "enum": [
            "SOURCE_FILE",
            "SYMBOL",
            "BUILD_TARGET",
            "TEST",
            "CONFIGURATION"
          ]
        },
        "source_commit": {
          "$ref": "#/$defs/oid"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "blob": {
          "$ref": "#/$defs/oid"
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "producer_receipt_id": {
          "$ref": "#/$defs/sha256"
        },
        "configuration_id": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "role",
        "observation_kind"
      ],
      "properties": {
        "receipt_id": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "enum": [
            "SUPPORTS",
            "CONTRADICTS"
          ]
        },
        "observation_kind": {
          "enum": [
            "SCIP_REFERENCE",
            "STATIC_IMPORT_CANDIDATE",
            "COMPILER_DECLARATION",
            "RUNTIME_WITNESS",
            "SCANNER_FINDING",
            "NATIVE_VERIFICATION",
            "REVIEW_EVENT"
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "predicate",
        "subjects",
        "assessment",
        "behavioral_verification",
        "support"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/sha256"
        },
        "predicate": {
          "enum": [
            "POSSIBLY_SAME_RESPONSIBILITY",
            "REALIZES_CONCEPT",
            "ALIAS_OF",
            "SHARES_INTERFACE",
            "BEHAVIORALLY_EQUIVALENT_UNDER",
            "CONTRADICTS"
          ]
        },
        "subjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "concept_id": {
          "$ref": "#/$defs/sha256"
        },
        "assessment": {
          "enum": [
            "PROPOSED",
            "CORROBORATED",
            "CONTRADICTED",
            "UNRESOLVED"
          ]
        },
        "behavioral_verification": {
          "enum": [
            "UNTESTED",
            "VERIFIED_UNDER_CONTRACT",
            "FAILED",
            "UNSUPPORTED"
          ]
        },
        "verification_contract_id": {
          "$ref": "#/$defs/sha256"
        },
        "support": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "BEHAVIORALLY_EQUIVALENT_UNDER"
              }
            },
            "required": [
              "predicate"
            ]
          },
          "then": {
            "required": [
              "verification_contract_id"
            ],
            "properties": {
              "behavioral_verification": {
                "const": "VERIFIED_UNDER_CONTRACT"
              },
              "support": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "const": "SUPPORTS"
                    },
                    "observation_kind": {
                      "const": "NATIVE_VERIFICATION"
                    }
                  },
                  "required": [
                    "role",
                    "observation_kind"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "behavioral_verification": {
                "const": "VERIFIED_UNDER_CONTRACT"
              }
            },
            "required": [
              "behavioral_verification"
            ]
          },
          "then": {
            "required": [
              "verification_contract_id"
            ],
            "properties": {
              "support": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "const": "SUPPORTS"
                    },
                    "observation_kind": {
                      "const": "NATIVE_VERIFICATION"
                    }
                  },
                  "required": [
                    "role",
                    "observation_kind"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "predicate": {
                "const": "REALIZES_CONCEPT"
              }
            },
            "required": [
              "predicate"
            ]
          },
          "then": {
            "required": [
              "concept_id"
            ]
          }
        }
      ]
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept_id",
        "revision_id",
        "name",
        "definition",
        "membership_claims",
        "review_status"
      ],
      "properties": {
        "concept_id": {
          "$ref": "#/$defs/sha256"
        },
        "revision_id": {
          "$ref": "#/$defs/sha256"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "membership_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          },
          "uniqueItems": true
        },
        "review_status": {
          "enum": [
            "UNREVIEWED",
            "ACCEPTED",
            "REJECTED",
            "SUPERSEDED"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "producer_receipts",
        "gaps"
      ],
      "properties": {
        "status": {
          "enum": [
            "PARTIAL",
            "DECLARED_SCOPE_COMPLETE",
            "UNKNOWN"
          ]
        },
        "producer_receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          },
          "uniqueItems": true
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason"
            ],
            "properties": {
              "source_path": {
                "$ref": "#/$defs/path"
              },
              "reason": {
                "enum": [
                  "UNSUPPORTED_LANGUAGE",
                  "MISSING_INDEXER",
                  "UNRESOLVED_SYMBOL",
                  "EXCLUDED_CONFIGURATION",
                  "RESOURCE_LIMIT",
                  "UNKNOWN_COVERAGE"
                ]
              }
            }
          }
        }
      }
    }
  }
}
