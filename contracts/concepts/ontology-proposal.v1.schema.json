{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/laurajoyhutchins/excession/main/contracts/concepts/ontology-proposal.v1.schema.json",
  "title": "Untrusted LLM-authored source-scoped ontology proposal v1",
  "description": "Human- or LLM-generated architectural interpretations, never native facts or reviewed certification. Git- and SCIP-bound identities are checked by Rust.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_commit",
    "source_tree",
    "batch_id",
    "author_label",
    "concepts"
  ],
  "properties": {
    "schema": {
      "const": "excession.concepts-ontology-proposal.v1"
    },
    "source_commit": {
      "$ref": "#/$defs/oid"
    },
    "source_tree": {
      "$ref": "#/$defs/oid"
    },
    "batch_id": {
      "$ref": "#/$defs/sha256"
    },
    "author_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Unverified descriptive label, not an authenticated agent identity."
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "name",
          "definition",
          "rationale",
          "members"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "$ref": "#/$defs/member"
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "predicate",
          "paths",
          "observations",
          "rationale"
        ],
        "properties": {
          "predicate": {
            "enum": [
              "POSSIBLY_SAME_RESPONSIBILITY",
              "SHARES_INTERFACE",
              "ALIAS_OF",
              "CONTRADICTS"
            ]
          },
          "paths": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/path"
            }
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/sha256"
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$"
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "observations"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  }
}
