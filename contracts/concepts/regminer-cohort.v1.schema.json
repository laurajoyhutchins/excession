{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Published RegMiner demonstration: exact working, inducing and repaired commits",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "dataset_repository",
    "dataset_revision",
    "dataset_document",
    "dataset_document_blob",
    "source_repository",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "excession.concepts.regminer-cohort.v1"
    },
    "dataset_repository": {
      "const": "SongXueZhi/RegMiner"
    },
    "dataset_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dataset_document": {
      "const": "artifact-evaluation.md"
    },
    "dataset_document_blob": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_repository": {
      "const": "uniVocity/univocity-parsers"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "working",
          "regression_inducing",
          "repaired",
          "test"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{2,80}$"
          },
          "working": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "regression_inducing": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "repaired": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "test": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "class",
              "method"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^src/test/java/.+\\.java$"
              },
              "class": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      }
    }
  }
}
