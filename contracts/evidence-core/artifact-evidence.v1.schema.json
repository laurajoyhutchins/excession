{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/laurajoyhutchins/excession/main/contracts/evidence-core/artifact-evidence.v1.schema.json",
  "title": "Excession source and REA evidence for exact artifact subject",
  "description": "Bounded, non-promoting artifact dossier. A linked build is replayed, while REA native predicates remain independently qualified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_subject_id",
    "artifact_sha256",
    "artifact_size_bytes",
    "build_evidence",
    "rea_evidence",
    "rea_total_stored",
    "rea_results_truncated",
    "source_artifact_relation",
    "behavioral_equivalence",
    "coverage_completeness",
    "report_id"
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "build_snapshot_id",
        "state",
        "semantic_correctness"
      ],
      "properties": {
        "bundle_id": {
          "$ref": "#/$defs/sha"
        },
        "build_snapshot_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha"
            }
          ]
        },
        "state": {
          "enum": [
            "BUILD_REPLAY_REQUIRED",
            "ARTIFACT_AND_NATIVE_RECORDS_REPLAYED"
          ]
        },
        "semantic_correctness": {
          "const": "NOT_ESTABLISHED"
        },
        "native_record_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ev_[0-9a-f]{64}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "ARTIFACT_AND_NATIVE_RECORDS_REPLAYED"
              }
            }
          },
          "then": {
            "required": [
              "native_record_ids"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "BUILD_REPLAY_REQUIRED"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "native_record_ids"
              ]
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schema": {
      "const": "excession.artifact-evidence.v1"
    },
    "artifact_subject_id": {
      "$ref": "#/$defs/sha"
    },
    "artifact_sha256": {
      "$ref": "#/$defs/sha"
    },
    "artifact_size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777216
    },
    "build_evidence": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "schema",
            "artifact_subject_id",
            "artifact_bytes_verified",
            "build_execution_verified"
          ],
          "properties": {
            "schema": {
              "const": "excession.build-provenance.v1"
            },
            "artifact_subject_id": {
              "$ref": "#/$defs/sha"
            },
            "artifact_bytes_verified": {
              "const": true
            },
            "build_execution_verified": {
              "const": false
            }
          }
        }
      ]
    },
    "rea_evidence": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "rea_total_stored": {
      "type": "integer",
      "minimum": 0
    },
    "rea_results_truncated": {
      "type": "boolean"
    },
    "source_artifact_relation": {
      "const": "NOT_ESTABLISHED"
    },
    "behavioral_equivalence": {
      "const": "NOT_ESTABLISHED"
    },
    "coverage_completeness": {
      "const": "NOT_ESTABLISHED"
    },
    "report_id": {
      "$ref": "#/$defs/sha"
    }
  }
}
