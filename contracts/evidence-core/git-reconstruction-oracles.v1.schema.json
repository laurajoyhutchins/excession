{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/excession/git-reconstruction-oracles.v1.schema.json",
  "title": "Excession reconstructed Git bounded-oracle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "checks"],
  "properties": {
    "schema": {"const": "excession.git-reconstruction-oracles.v1"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase", "checkpoint", "contracts", "checkout", "program", "program_sha256",
          "oracle_source", "oracle_sha256", "args", "timeout_ms", "expected_stdout_sha256"
        ],
        "properties": {
          "phase": {"enum": ["INTRODUCTION", "INTEGRATION"]},
          "checkpoint": {"$ref": "#/$defs/sha1"},
          "contracts": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "checkout": {"$ref": "#/$defs/absolutePath"},
          "program": {"$ref": "#/$defs/absolutePath"},
          "program_sha256": {"$ref": "#/$defs/sha256"},
          "oracle_source": {"$ref": "#/$defs/absolutePath"},
          "oracle_sha256": {"$ref": "#/$defs/sha256"},
          "args": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"type": "string", "maxLength": 2048}},
          "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 15000},
          "expected_stdout_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolutePath": {"type": "string", "minLength": 2, "pattern": "^/"}
  }
}
