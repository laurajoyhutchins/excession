{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Excession Git reconstruction synthesis seed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target_commit",
    "source_dependencies",
    "contracts"
  ],
  "properties": {
    "schema": {
      "const": "excession.git-reconstruction-seed.v1"
    },
    "target_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_dependencies": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "requires"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_closure",
          "requires"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source_closure": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
