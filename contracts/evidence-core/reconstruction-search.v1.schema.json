{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Excession bounded reconstruction search",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "search_id",
    "generator",
    "target_artifact_subject_id",
    "target_artifact_sha256",
    "target_text_sha256",
    "target_function",
    "language",
    "compiler",
    "objcopy",
    "objdump",
    "nm",
    "max_candidates",
    "time_budget_seconds",
    "attempt_count",
    "search_status",
    "best_expression",
    "best_source",
    "best_source_sha256",
    "best_text_sha256",
    "best_mismatch_count",
    "attempts",
    "target_rea_bundles",
    "execution_boundary",
    "comparison_scope",
    "source_recovery",
    "behavioral_equivalence",
    "build_execution_attested",
    "search_exhaustive",
    "candidate_selection",
    "reused_from_search_id"
  ],
  "properties": {
    "schema": {
      "const": "excession.reconstruction-search.v1"
    },
    "search_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generator": {
      "const": "c-one-arg-integer-v1"
    },
    "target_artifact_subject_id": {
      "type": "string",
      "minLength": 1
    },
    "target_artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_text_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_function": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "maxLength": 128
    },
    "language": {
      "const": "C"
    },
    "compiler": {
      "type": "string",
      "minLength": 1
    },
    "objcopy": {
      "type": "string",
      "minLength": 1
    },
    "objdump": {
      "type": "string",
      "minLength": 1
    },
    "nm": {
      "type": "string",
      "minLength": 1
    },
    "max_candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "time_budget_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "search_status": {
      "enum": [
        "EXACT_TEXT_MATCH",
        "TIME_BUDGET_EXHAUSTED",
        "CANDIDATE_BUDGET_EXHAUSTED"
      ]
    },
    "best_expression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "best_source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "best_source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "best_text_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "best_mismatch_count": {
      "type": "integer",
      "minimum": 0
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expression",
          "source_sha256",
          "text_sha256",
          "mismatch_count",
          "mismatch_examples"
        ],
        "properties": {
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mismatch_count": {
            "type": "integer",
            "minimum": 0
          },
          "mismatch_examples": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "offset",
                "target",
                "candidate"
              ],
              "properties": {
                "offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "target": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 255
                },
                "candidate": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 255
                }
              }
            }
          }
        }
      }
    },
    "target_rea_bundles": {
      "type": "integer",
      "minimum": 0
    },
    "execution_boundary": {
      "const": "TRUSTED_LOCAL_UNSANDBOXED"
    },
    "comparison_scope": {
      "const": "ELF_TEXT_SECTION_BYTES_ONLY"
    },
    "source_recovery": {
      "const": "NOT_ESTABLISHED"
    },
    "behavioral_equivalence": {
      "const": "NOT_ESTABLISHED"
    },
    "build_execution_attested": {
      "const": false
    },
    "search_exhaustive": {
      "const": false
    },
    "candidate_selection": {
      "type": "string",
      "enum": [
        "REUSED_EXACT_TEXT",
        "GENERATED_GRAMMAR"
      ]
    },
    "reused_from_search_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
