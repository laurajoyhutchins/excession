{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/laurajoyhutchins/excession/main/contracts/evidence-core/unknown-event.v1.schema.json",
  "title": "contracts: append-only unknowns and evidence-resolution event history",
  "description": "Proposed wire shape only; no source, execution or semantic proof from schema validity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "unknown_id",
    "question",
    "scope_commit",
    "revision",
    "expected_previous_revision",
    "state",
    "support_receipts",
    "counterevidence_receipts",
    "required_evidence",
    "action",
    "resolution_receipt",
    "event_semantics"
  ],
  "properties": {
    "schema": {
      "const": "excession.unknown-event.v1"
    },
    "unknown_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "scope_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_previous_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "OPEN",
        "RESOLVED",
        "REOPENED",
        "DISMISSED",
        "UNSUPPORTED"
      ]
    },
    "support_receipts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "counterevidence_receipts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "SCIP_DEFINITION",
          "GIT_REPLAY",
          "NATIVE_BUILD",
          "RUNTIME_WITNESS",
          "INDEPENDENT_TEST",
          "REVIEW_EVENT"
        ]
      }
    },
    "action": {
      "type": "string",
      "enum": [
        "CREATE",
        "ADD_EVIDENCE",
        "RESOLVE",
        "REOPEN",
        "DISMISS"
      ]
    },
    "resolution_receipt": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_semantics": {
      "const": "APPEND_ONLY_WITH_EXPECTED_REVISION"
    }
  }
}
