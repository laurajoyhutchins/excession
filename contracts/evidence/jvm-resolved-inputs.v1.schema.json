{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laurajoyhutchins/excession/blob/main/contracts/evidence/jvm-resolved-inputs.v1.schema.json",
  "title": "Externally resolved JVM compilation inputs (unattested provider claim)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "provider_claim", "source_commit", "source_tree",
    "source_prefix", "sources", "classpath", "release"
  ],
  "properties": {
    "schema": {"const": "excession.jvm-resolved-inputs.v1"},
    "provider_claim": {"enum": ["maven", "gradle"]},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_prefix": {"type": "string", "minLength": 1, "maxLength": 4096},
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 6, "maxLength": 4096, "pattern": "\\.java$"}
    },
    "classpath": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 6, "maxLength": 4096, "pattern": "^/.*\\.jar$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216}
        }
      }
    },
    "release": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^(8|9|[1-2][0-9]|30)$"}
      ]
    }
  }
}
