{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/laurajoyhutchins/excession/main/contracts/product/acceptance-case.v1.schema.json",
  "title": "Excession draft acceptance-case.v1.schema.json",
  "description": "Normative proposed wire shape; not an assertion of implemented behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "repository",
    "source_commit",
    "oracle_kind",
    "expected_relationships",
    "mutations",
    "measurement_status",
    "coverage_status"
  ],
  "properties": {
    "schema": {
      "const": "excession.acceptance-case.v1"
    },
    "case_id": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "$ref": "common.v1.schema.json#/$defs/oid"
    },
    "oracle_kind": {
      "enum": [
        "INDEPENDENT_GIT_AND_NATIVE",
        "INDEPENDENT_SOURCE_MANIFEST",
        "MANUALLY_REVIEWED_HELD_OUT"
      ]
    },
    "expected_relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "relation"
        ],
        "properties": {
          "from": {
            "$ref": "common.v1.schema.json#/$defs/source_ref"
          },
          "to": {
            "$ref": "common.v1.schema.json#/$defs/source_ref"
          },
          "relation": {
            "enum": [
              "STATIC_IMPORT",
              "SCIP_REFERENCE",
              "CONFIGURED_DEPENDENCY",
              "NATIVE_DECLARATION"
            ]
          }
        }
      }
    },
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "DELETE_TRUE_EDGE",
          "INSERT_FALSE_EDGE",
          "FORGE_SOURCE_BLOB",
          "ALTER_CONFIGURATION",
          "STALE_REPORT",
          "OMIT_UNSUPPORTED"
        ]
      }
    },
    "measurement_status": {
      "enum": [
        "NOT_RUN",
        "MEASURED"
      ]
    },
    "coverage_status": {
      "enum": [
        "PARTIAL",
        "DECLARED_SCOPE_COMPLETE",
        "UNKNOWN"
      ]
    },
    "ontology_evaluation_report_id": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    }
  }
}
