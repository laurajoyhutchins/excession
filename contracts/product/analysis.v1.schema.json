{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/laurajoyhutchins/excession/main/contracts/product/analysis.v1.schema.json",
  "title": "test/contracts: scaffold one-command analyze workflow (#79)",
  "description": "Proposed product contract; TDD scaffold only, not an implemented Excession command.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report_id",
    "source_commit",
    "source_tree",
    "status",
    "observation_receipts",
    "relationships",
    "coverage"
  ],
  "properties": {
    "schema": {
      "const": "excession.analysis.v1"
    },
    "report_id": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "source_commit": {
      "$ref": "common.v1.schema.json#/$defs/oid"
    },
    "source_tree": {
      "$ref": "common.v1.schema.json#/$defs/oid"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "PARTIAL"
      ]
    },
    "observation_receipts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/sha256"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target",
          "kind",
          "evidence"
        ],
        "properties": {
          "source": {
            "$ref": "common.v1.schema.json#/$defs/source_ref"
          },
          "target": {
            "$ref": "common.v1.schema.json#/$defs/source_ref"
          },
          "kind": {
            "enum": [
              "STATIC_IMPORT",
              "SCIP_REFERENCE",
              "CONFIGURED_DEPENDENCY",
              "NATIVE_DECLARATION"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.v1.schema.json#/$defs/evidence_ref"
            }
          }
        }
      }
    },
    "coverage": {
      "$ref": "common.v1.schema.json#/$defs/coverage"
    },
    "ontology_links": {
      "type": "array",
      "items": {
        "$ref": "common.v1.schema.json#/$defs/ontology_link_ref"
      }
    }
  }
}
