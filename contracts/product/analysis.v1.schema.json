{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/laurajoyhutchins/excession/main/contracts/product/analysis.v1.schema.json",
  "title": "test/contracts: scaffold one-command analyze workflow (#79)",
  "description": "Proposed product contract; TDD scaffold only, not an implemented Excession command.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report_id",
    "source_commit",
    "source_tree",
    "status",
    "observation_receipts",
    "relationships",
    "coverage"
  ],
  "properties": {
    "schema": {
      "const": "excession.analysis.v1"
    },
    "report_id": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "source_commit": {
      "$ref": "common.v1.schema.json#/$defs/oid"
    },
    "source_tree": {
      "$ref": "common.v1.schema.json#/$defs/oid"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "PARTIAL"
      ]
    },
    "observation_receipts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/sha256"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target",
          "kind",
          "evidence"
        ],
        "properties": {
          "source": {
            "$ref": "common.v1.schema.json#/$defs/source_ref"
          },
          "target": {
            "$ref": "common.v1.schema.json#/$defs/source_ref"
          },
          "kind": {
            "enum": [
              "STATIC_IMPORT",
              "SCIP_REFERENCE",
              "CONFIGURED_DEPENDENCY",
              "NATIVE_DECLARATION"
            ]
          },
          "native_observation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["snapshot_id", "observation_id", "native_kind", "symbol", "line"],
            "properties": {
              "snapshot_id": { "$ref": "common.v1.schema.json#/$defs/sha256" },
              "observation_id": { "$ref": "common.v1.schema.json#/$defs/sha256" },
              "native_kind": { "const": "SCIP_SYMBOL_REFERENCE" },
              "symbol": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.v1.schema.json#/$defs/evidence_ref"
            }
          }
        }
      }
    },
    "coverage": {
      "$ref": "common.v1.schema.json#/$defs/coverage"
    },
    "producer_selection_plan": { "$ref": "#/$defs/producer_plan" },
    "producer_selections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scip_snapshot", "graph_id", "source_prefix"],
      "properties": {
        "scip_snapshot": { "oneOf": [{ "$ref": "common.v1.schema.json#/$defs/sha256" }, { "type": "null" }] },
        "graph_id": { "oneOf": [{ "$ref": "common.v1.schema.json#/$defs/sha256" }, { "type": "null" }] },
        "source_prefix": { "type": ["string", "null"] }
      }
    },
    "producer_coverage": { "type": "array", "items": { "type": "object" } },
    "configured_observations": { "type": "array", "items": { "$ref": "#/$defs/configured_observation" } },
    "ontology_links": {
      "type": "array",
      "items": {
        "$ref": "common.v1.schema.json#/$defs/ontology_link_ref"
      }
    }
  },
  "$defs": {
    "producer_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scip", "graphs", "blocked_paths", "gaps"],
      "properties": {
        "scip": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["snapshot_id", "source_prefix"],
            "properties": {
              "snapshot_id": { "$ref": "common.v1.schema.json#/$defs/sha256" },
              "source_prefix": { "oneOf": [{ "$ref": "common.v1.schema.json#/$defs/path" }, { "type": "null" }] }
            }
          }
        },
        "graphs": { "type": "array", "maxItems": 24, "uniqueItems": true, "items": { "$ref": "common.v1.schema.json#/$defs/sha256" } },
        "blocked_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.v1.schema.json#/$defs/path" } },
        "gaps": { "type": "array", "maxItems": 10000, "items": { "$ref": "common.v1.schema.json#/$defs/coverage_gap" } }
      }
    },
    "configured_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_id", "source", "entity", "entity_role", "direction", "relation", "native_kind", "status", "evidence"],
      "properties": {
        "graph_id": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "source": { "$ref": "common.v1.schema.json#/$defs/source_ref" },
        "entity": { "type": "string", "minLength": 1 },
        "entity_role": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["SOURCE_TO_ENTITY", "ENTITY_TO_SOURCE"] },
        "relation": { "type": "string", "minLength": 1 },
        "native_kind": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
