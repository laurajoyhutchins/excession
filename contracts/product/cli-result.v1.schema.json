{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/laurajoyhutchins/excession/main/contracts/product/cli-result.v1.schema.json",
  "title": "Excession public operation summary v1 (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "status",
    "report_id",
    "coverage"
  ],
  "properties": {
    "schema": {
      "const": "excession.cli-result.v1"
    },
    "operation": {
      "enum": [
        "ANALYZE",
        "IMPACT",
        "EXPLAIN",
        "AUDIT"
      ]
    },
    "status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNAVAILABLE"
      ]
    },
    "report_id": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "coverage": {
      "$ref": "common.v1.schema.json#/$defs/coverage"
    },
    "source_commit": {
      "$ref": "common.v1.schema.json#/$defs/oid"
    },
    "artifact_path": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "maxLength": 1024
    }
  }
}
