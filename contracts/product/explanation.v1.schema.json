{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/laurajoyhutchins/excession/main/contracts/product/explanation.v1.schema.json",
  "title": "Excession proposed explanation.v1.schema.json",
  "description": "Draft public product wire, not proof of correctness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report_id",
    "claim_id",
    "source_commit",
    "steps",
    "coverage"
  ],
  "properties": {
    "schema": {
      "const": "excession.explanation.v1"
    },
    "report_id": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "claim_id": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "source_commit": {
      "$ref": "common.v1.schema.json#/$defs/oid"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target",
          "relation",
          "evidence"
        ],
        "properties": {
          "source": {
            "$ref": "common.v1.schema.json#/$defs/source_ref"
          },
          "target": {
            "$ref": "common.v1.schema.json#/$defs/source_ref"
          },
          "relation": {
            "enum": [
              "STATIC_IMPORT",
              "SCIP_REFERENCE",
              "CONFIGURED_DEPENDENCY",
              "NATIVE_DECLARATION",
              "RUNTIME_WITNESS"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.v1.schema.json#/$defs/evidence_ref"
            }
          }
        }
      }
    },
    "coverage": {
      "$ref": "common.v1.schema.json#/$defs/coverage"
    },
    "ontology_links": {
      "type": "array",
      "items": {
        "$ref": "common.v1.schema.json#/$defs/ontology_link_ref"
      }
    }
  }
}
