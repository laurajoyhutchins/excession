{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/laurajoyhutchins/excession/main/contracts/product/impact.v1.schema.json",
  "title": "Excession proposed impact.v1.schema.json",
  "description": "Draft public product wire, not proof of correctness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report_id",
    "base_commit",
    "head_commit",
    "change_inventory_id",
    "effects",
    "unknown",
    "coverage",
    "safe_to_skip_unlisted_tests"
  ],
  "properties": {
    "schema": {
      "const": "excession.impact.v1"
    },
    "report_id": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "base_commit": {
      "$ref": "common.v1.schema.json#/$defs/oid"
    },
    "head_commit": {
      "$ref": "common.v1.schema.json#/$defs/oid"
    },
    "change_inventory_id": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity",
          "assessment",
          "hops",
          "claim_id"
        ],
        "properties": {
          "entity": {
            "$ref": "common.v1.schema.json#/$defs/source_ref"
          },
          "assessment": {
            "enum": [
              "OBSERVED_RELATIONSHIP_PATH",
              "CANDIDATE_PATH"
            ]
          },
          "hops": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/hop"
            }
          },
          "claim_id": {
            "$ref": "common.v1.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "unknown": {
      "type": "array",
      "items": {
        "$ref": "common.v1.schema.json#/$defs/coverage_gap"
      }
    },
    "coverage": {
      "$ref": "common.v1.schema.json#/$defs/coverage"
    },
    "safe_to_skip_unlisted_tests": {
      "const": false
    },
    "ontology_links": {
      "type": "array",
      "items": {
        "$ref": "common.v1.schema.json#/$defs/ontology_link_ref"
      }
    }
  },
  "$defs": {
    "hop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "relation",
        "evidence"
      ],
      "properties": {
        "source": {
          "$ref": "common.v1.schema.json#/$defs/source_ref"
        },
        "target": {
          "$ref": "common.v1.schema.json#/$defs/source_ref"
        },
        "relation": {
          "enum": [
            "STATIC_IMPORT",
            "SCIP_REFERENCE",
            "CONFIGURED_DEPENDENCY",
            "NATIVE_DECLARATION",
            "RUNTIME_WITNESS"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.v1.schema.json#/$defs/evidence_ref"
          }
        }
      }
    }
  }
}
