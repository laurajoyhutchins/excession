{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laurajoyhutchins/excession/contracts/product/investigation-event.v1.schema.json",
  "title": "Excession append-only investigation event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "investigation_id",
    "revision",
    "previous_event_id",
    "question",
    "source_commit",
    "source_tree",
    "kind",
    "payload",
    "event_id"
  ],
  "properties": {
    "schema": {
      "const": "excession.investigation-event.v1"
    },
    "investigation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previous_event_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "kind": {
      "enum": [
        "CREATE",
        "CLAIM",
        "PLAN",
        "VERIFY",
        "EXPLORE",
        "QUESTION",
        "SYNTHESIS",
        "REFRESH"
      ]
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "CREATE"
        },
        "payload": {
          "type": "object",
          "maxProperties": 0
        }
      },
      "required": [
        "kind",
        "payload"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "CLAIM"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "statement",
            "assumption",
            "assessment"
          ],
          "properties": {
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "commit",
                "tree",
                "path",
                "blob",
                "mode"
              ],
              "properties": {
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "tree": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "blob": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "mode": {
                  "enum": [
                    "100644",
                    "100755"
                  ]
                }
              }
            },
            "statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "assumption": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "assessment": {
              "enum": [
                "HYPOTHESIS",
                "SOURCE_REVIEW_REPORTED"
              ]
            }
          }
        }
      },
      "required": [
        "kind",
        "payload"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "PLAN"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claim_event_id",
            "obligation"
          ],
          "properties": {
            "claim_event_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "obligation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          }
        }
      },
      "required": [
        "kind",
        "payload"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "VERIFY"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan_event_id",
            "report"
          ],
          "properties": {
            "plan_event_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "report": {
              "type": "object",
              "required": [
                "schema",
                "report_id",
                "base_commit",
                "base_tree",
                "candidate_commit",
                "candidate_tree",
                "status",
                "ready_to_merge",
                "safe_to_skip_unlisted_tests",
                "obligations"
              ],
              "properties": {
                "schema": {
                  "const": "excession.agent-verification.v1"
                },
                "report_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "base_commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "base_tree": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "candidate_commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "candidate_tree": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "status": {
                  "enum": [
                    "OPEN_OBLIGATIONS",
                    "REPORTED_FAILURE"
                  ]
                },
                "ready_to_merge": {
                  "const": false
                },
                "safe_to_skip_unlisted_tests": {
                  "const": false
                },
                "obligations": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          }
        }
      },
      "required": [
        "kind",
        "payload"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "EXPLORE"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "report"
          ],
          "properties": {
            "report": {
              "type": "object",
              "required": [
                "schema",
                "report_id",
                "source_commit",
                "source_tree",
                "task",
                "reading_plan",
                "index",
                "coverage",
                "candidates",
                "relationship_candidates",
                "safe_to_skip_unlisted_tests"
              ],
              "properties": {
                "schema": {
                  "const": "excession.agent-locate.v1"
                },
                "report_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "source_commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "source_tree": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "task": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "safe_to_skip_unlisted_tests": {
                  "const": false
                }
              }
            }
          }
        }
      },
      "required": [
        "kind",
        "payload"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "QUESTION"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "question",
            "reason"
          ],
          "properties": {
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          }
        }
      },
      "required": [
        "kind",
        "payload"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "SYNTHESIS"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "narrative",
            "claim_event_ids"
          ],
          "properties": {
            "narrative": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "claim_event_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      },
      "required": [
        "kind",
        "payload"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "REFRESH"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_commit",
            "candidate_tree",
            "change_inventory_id",
            "changed_path_count",
            "claim_assessments",
            "dependency_completeness",
            "semantic_verification",
            "refresh_id"
          ],
          "properties": {
            "candidate_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "candidate_tree": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "change_inventory_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "changed_path_count": {
              "type": "integer",
              "minimum": 0
            },
            "refresh_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "claim_assessments": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "claim_event_id",
                  "path",
                  "direct_source",
                  "semantic_impact"
                ],
                "properties": {
                  "claim_event_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "direct_source": {
                    "enum": [
                      "DIRECT_SOURCE_UNCHANGED",
                      "DIRECT_SOURCE_CHANGED",
                      "DIRECT_SOURCE_UNAVAILABLE"
                    ]
                  },
                  "semantic_impact": {
                    "const": "UNRESOLVED"
                  }
                }
              }
            },
            "dependency_completeness": {
              "const": "NOT_ESTABLISHED"
            },
            "semantic_verification": {
              "const": "NOT_ESTABLISHED"
            }
          }
        }
      },
      "required": [
        "kind",
        "payload"
      ]
    }
  ]
}
