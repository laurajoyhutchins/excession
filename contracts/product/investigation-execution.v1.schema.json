{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laurajoyhutchins/excession/contracts/product/investigation-execution.v1.schema.json",
  "title": "Trusted-local differential execution observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "base_commit",
    "base_tree",
    "candidate_commit",
    "candidate_tree",
    "plan_event_id",
    "witness_event_ids",
    "program",
    "limits",
    "environment",
    "base",
    "candidate",
    "comparison",
    "trust",
    "semantic_verification",
    "ready_to_merge",
    "report_id"
  ],
  "properties": {
    "schema": {
      "const": "excession.investigation-execution.v1"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "plan_event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "witness_event_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "argv"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_ms",
        "max_output_bytes"
      ],
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "environment": {
      "const": "FIXED_MINIMAL_PROCESS_ENV_HOST_UNATTESTED"
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "status",
        "exit_code",
        "stdout_sha256",
        "stderr_sha256",
        "stdout_bytes",
        "stderr_bytes"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "status": {
          "enum": [
            "EXITED",
            "TIMEOUT",
            "OUTPUT_LIMIT",
            "TERMINATED_BY_SIGNAL"
          ]
        },
        "exit_code": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "stdout_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "stderr_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "stdout_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "stderr_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "status",
        "exit_code",
        "stdout_sha256",
        "stderr_sha256",
        "stdout_bytes",
        "stderr_bytes"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "status": {
          "enum": [
            "EXITED",
            "TIMEOUT",
            "OUTPUT_LIMIT",
            "TERMINATED_BY_SIGNAL"
          ]
        },
        "exit_code": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "stdout_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "stderr_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "stdout_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "stderr_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "comparison": {
      "enum": [
        "AGREEMENT_OBSERVED",
        "DIFFERENCE_OBSERVED",
        "INCONCLUSIVE"
      ]
    },
    "trust": {
      "const": "TRUSTED_LOCAL_EXECUTION_UNATTESTED"
    },
    "semantic_verification": {
      "const": "NOT_ESTABLISHED"
    },
    "ready_to_merge": {
      "const": false
    },
    "report_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
