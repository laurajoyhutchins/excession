{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/laurajoyhutchins/excession/main/contracts/product/onboarding-example.v1.schema.json",
  "title": "Excession draft onboarding-example.v1.schema.json",
  "description": "Normative proposed wire shape; not an assertion of implemented behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "example_id",
    "supported_release_status",
    "commands",
    "required_tools"
  ],
  "properties": {
    "schema": {
      "const": "excession.onboarding-example.v1"
    },
    "example_id": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "supported_release_status": {
      "enum": [
        "PROPOSED_NOT_SHIPPED",
        "SHIPPED_AND_SMOKE_TESTED"
      ]
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "role"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "role": {
            "enum": [
              "PREPARE",
              "ANALYZE",
              "IMPACT",
              "EXPLAIN",
              "AUDIT",
              "VERIFY"
            ]
          }
        }
      }
    },
    "required_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "source_revision": {
      "$ref": "common.v1.schema.json#/$defs/oid"
    }
  }
}
