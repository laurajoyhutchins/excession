{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/laurajoyhutchins/excession/main/contracts/product/release-manifest.v1.schema.json",
  "title": "Excession draft release-manifest.v1.schema.json",
  "description": "Normative proposed wire shape; not an assertion of implemented behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "source_commit",
    "assets",
    "attestation_status"
  ],
  "properties": {
    "schema": {
      "const": "excession.release-manifest.v1"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.-]+)?$"
    },
    "source_commit": {
      "$ref": "common.v1.schema.json#/$defs/oid"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "filename",
          "sha256"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "$ref": "common.v1.schema.json#/$defs/sha256"
          },
          "sidecar_sha256": {
            "$ref": "common.v1.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "attestation_status": {
      "enum": [
        "NOT_ATTESTED",
        "ATTESTED"
      ]
    },
    "attestation_digest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "attestation_status": {
            "const": "ATTESTED"
          }
        },
        "required": [
          "attestation_status"
        ]
      },
      "then": {
        "required": [
          "attestation_digest"
        ]
      }
    }
  ]
}
