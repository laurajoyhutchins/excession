{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laurajoyhutchins/excession/blob/main/contracts/security-candidate.schema.json",
  "title": "Source-bound security discovery candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "scanner",
    "applicability",
    "weakness",
    "observation",
    "disposition"
  ],
  "properties": {
    "schema": {
      "const": "excession.security.candidate.v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "path",
        "blob",
        "start_line"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "blob": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "version",
        "ruleset_digest",
        "report_sha256",
        "rule_id"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "ruleset_digest": {
          "type": "string",
          "minLength": 1
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "framework",
        "status",
        "evidence"
      ],
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "weakness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "cwe": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^CWE-[0-9]+$"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_SCANNED",
            "UNSUPPORTED",
            "NO_CANDIDATE",
            "CANDIDATE",
            "INCONCLUSIVE"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "disposition": {
      "enum": [
        "UNJUDGED",
        "INCONCLUSIVE",
        "REPRODUCED",
        "NOT_REPRODUCED"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "observation": {
            "properties": {
              "status": {
                "const": "CANDIDATE"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "applicability": {
            "properties": {
              "status": {
                "const": "APPLICABLE"
              }
            }
          },
          "observation": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "applicability": {
            "properties": {
              "status": {
                "enum": [
                  "UNKNOWN",
                  "NOT_APPLICABLE"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "observation": {
            "properties": {
              "status": {
                "enum": [
                  "INCONCLUSIVE",
                  "UNSUPPORTED",
                  "NOT_SCANNED"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "enum": [
              "REPRODUCED",
              "NOT_REPRODUCED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "observation": {
            "properties": {
              "status": {
                "const": "CANDIDATE"
              }
            }
          }
        }
      }
    }
  ]
}
