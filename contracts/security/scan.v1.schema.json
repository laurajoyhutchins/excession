{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laurajoyhutchins/excession/blob/main/contracts/security/scan.v1.schema.json",
  "title": "Source-bound scanner execution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scan_id",
    "source",
    "scanner",
    "ruleset",
    "scope",
    "execution",
    "report",
    "ingest"
  ],
  "properties": {
    "schema": {
      "const": "excession.security.scan.v1"
    },
    "scan_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "version",
        "toolchain_ref"
      ],
      "properties": {
        "engine": {
          "enum": [
            "semgrep",
            "codeql"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "toolchain_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immutable_ref",
        "configuration_sha256",
        "selection"
      ],
      "properties": {
        "immutable_ref": {
          "type": "string",
          "minLength": 1
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languages",
        "include_paths",
        "excluded_paths"
      ],
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "include_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:\\.|(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*://)(?!.*[?#%]).+)$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "excluded_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*://)(?!.*[?#%]).+$"
          },
          "uniqueItems": true
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "exit_code",
        "errors",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "FAILED",
            "NOT_RUN"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "report": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "sha256",
            "bytes"
          ],
          "properties": {
            "format": {
              "enum": [
                "SARIF_2_1_0",
                "SEMGREP_JSON"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "ingest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "independently_replayed"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "independently_replayed": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "status": {
                "const": "COMPLETE"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "exit_code": {
                "const": 0
              },
              "errors": {
                "maxItems": 0
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          },
          "report": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "status": {
                "const": "NOT_RUN"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "exit_code": {
                "type": "null"
              },
              "errors": {
                "maxItems": 0
              }
            }
          },
          "report": {
            "type": "null"
          },
          "ingest": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "status": {
                "const": "FAILED"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "errors": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
