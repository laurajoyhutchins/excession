# Copy this file to deploy/.env, generate a random token, and keep it private.
# EXCESSION_SERVICE_TOKEN must contain at least 32 random characters.
EXCESSION_SERVICE_TOKEN=
# Only these HTTPS GitHub repositories are cloned. No arbitrary repository URLs are accepted from requests.
EXCESSION_SOURCES={"excession":"https://github.com/laurajoyhutchins/excession.git"}
